# Public web build values
VITE_CONVEX_URL=
VITE_VAPID_PUBLIC_KEY=

# Convex runtime values (configure on the target Convex deployment)
CONVEX_SITE_URL=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Production Convex needs AUTH_RESEND_KEY set on the deployment.
AUTH_RESEND_KEY=
# Production Convex must set ENVIRONMENT=production so OTP is not sent from Resend's test sender.
ENVIRONMENT=development
# Public site URL for this Convex deployment.
# Production must be SITE_URL=https://crossplatformkorea.com so live OTP uses the verified from-address
# even if ENVIRONMENT is not set to production. Local/dev may use localhost.
SITE_URL=
# Optional OTP From address override. Production default is crossplatformkorea@hyo.dev.
# Do not use onboarding@resend.dev on the public site; Resend only delivers that to the account owner.
AUTH_EMAIL_FROM=
VAPID_SUBJECT=mailto:crossplatformkorea@gmail.com
VAPID_PRIVATE_KEY=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# GitHub Actions secrets (configure in repository settings; never locally)
# CONVEX_DEPLOY_KEY=
# FIREBASE_SERVICE_ACCOUNT_CROSS_PLATFORM_KOREA_73395=

# Shared secret for the YouTube companion worker calling Convex HTTP admin routes.
# Set this on the Convex deployment (and locally if you call /admin/*). Never commit the real value.
CPK_WORKER_TOKEN=
