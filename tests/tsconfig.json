{
  /* Type-check context for the bun test suite so ESLint's type-aware rules
   * can resolve these files (they live outside the web and convex projects). */
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2021", "ES2022.Intl", "dom"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["./**/*"]
}
